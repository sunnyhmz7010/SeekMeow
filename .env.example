# 必填：MeoW 用户昵称
MEOW_NICKNAME=你的昵称

# 可选：检查频率，单位为秒，默认 5，范围 1-2147483
CHECK_INTERVAL_SECONDS=5

# 可选：title / summary / all，默认 all
MATCH_SCOPE=all

# 默认 all；可用标识：daily,tech,info,review,trade,carpool,promo,life,dev,photo-share,expose,inner,sandbox。作为全局过滤，PUSH_CATEGORY 的匹配范围也受此限制
CATEGORIES=all

# 普通关键词：命中任意一个即推送
KEYWORDS=VPS,优惠,补货

# 组合规则：任意一组中的全部词都命中才推送
KEYWORD_GROUPS=[["香港","VPS"],["日本","线路"]]

# 正则表达式：命中任意一个即推送，固定使用 iu 标志
REGEX_PATTERNS=["年付\\s*\\d+","香港|日本"]

# 版块匹配：命中指定版块即推送，可与关键词等规则同时使用。all 或英文逗号分隔的版块标识
PUSH_CATEGORY=trade

# 屏蔽词：命中任意一个便不推送，所有模式下均生效
BLOCK_KEYWORDS=求购,已收

# 首次启动是否推送 RSS 中已有的匹配帖子，默认 false
PUSH_EXISTING=false

# 定时自检间隔（分钟），默认 60，设为 0 关闭。自检时会测试 RSS 与 MeoW 连接并推送一条通知
HEALTH_CHECK_MINUTES=60
