# 必填：MeoW 用户昵称
MEOW_NICKNAME=你的昵称

# 可选：检查频率，单位为秒，默认 5，范围 1-2147483
CHECK_INTERVAL_SECONDS=5

# 可选：title / summary / all，默认 all
MATCH_SCOPE=all

# 普通关键词：命中任意一个即提醒
KEYWORDS=VPS,优惠,补货

# 组合规则：任意一组中的全部词都命中才提醒
KEYWORD_GROUPS=[["香港","VPS"],["日本","线路"]]

# 屏蔽词：命中任意一个便不推送
BLOCK_KEYWORDS=求购,已收

# 正则表达式：命中任意一个即提醒，固定使用 iu 标志
REGEX_PATTERNS=["年付\\s*\\d+","香港|日本"]

# 默认 all；可用 slug：daily,tech,info,review,trade,carpool,promo,life,dev,photo-share,expose,inner,sandbox
CATEGORIES=all

# 首次启动是否推送 RSS 中已有的匹配帖子，默认 false
PUSH_EXISTING=false
